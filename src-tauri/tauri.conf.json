{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hodie",
  "version": "0.1.0",
  "identifier": "app.hodie.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hodie",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false
      },
      {
        "label": "quick-add",
        "title": "Hodie",
        "width": 560,
        "height": 92,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Fynn",
    "category": "Productivity",
    "shortDescription": "To-do app as a Kanban board",
    "longDescription": "Hodie is a desktop to-do app built as a Kanban board: boards, columns and cards with notes, subtasks, priority and tags. All data stays on your computer.",
    "copyright": "© 2026 Fynn",
    "windows": {
      "nsis": {
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
